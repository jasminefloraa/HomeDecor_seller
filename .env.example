# Optional: better business data. console.cloud.google.com -> enable "Places API (New)" -> Credentials -> API key
GOOGLE_PLACES_KEY=
# Optional fallback email finder. hunter.io -> API
HUNTER_KEY=
# Required to send. Gmail: turn on 2-step verification, then myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_NAME=Your Name
# Required by US CAN-SPAM: a real postal address, added to every email
POSTAL_ADDRESS=123 Main St, City, State ZIP
